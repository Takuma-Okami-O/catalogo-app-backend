+# Copia este archivo a .env y completa los valores reales.
+# .env NUNCA debe subirse a git (ya está en .gitignore).
+
+# --- Base de datos ---
+# Si no se define, el server corre con repositorios en memoria (solo desarrollo).
+DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd"
+
+# --- Autenticación (obligatorias) ---
+JWT_ACCESS_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"
+JWT_REFRESH_SECRET="cambia_esto_por_otro_secreto_largo_y_aleatorio"
+JWT_ACCESS_EXPIRES_IN="15m"
+JWT_REFRESH_EXPIRES_IN="7d"
+
+# --- Agente de ventas con IA (Claude) ---
+# Se obtiene en https://console.anthropic.com/ -> API Keys.
+# Sin esta variable, el endpoint /agente/chat responderá con error.
+ANTHROPIC_API_KEY="sk-ant-..."
+
+# --- Envío de emails (recuperación de contraseña, etc.) ---
+RESEND_API_KEY="re_..."
+RESEND_FROM_EMAIL="no-reply@tudominio.com"
+
+# --- Branding del catálogo público ---
+PLATFORM_NAME="Catálogo App"
+COMPANY_NAME="TĀKŪMĀ Group"
+COMPANY_WEBSITE_URL="https://tusitio.com"
+APP_DOWNLOAD_URL="#"
+SHOW_APP_PROMO="false"
+
+# --- Servidor ---
+PORT=3000
+NODE_ENV="development"
