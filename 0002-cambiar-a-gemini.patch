From 0257da6ed5d64d3da70274d26dc734fb326eebb0 Mon Sep 17 00:00:00 2001
From: Catalogo App Dev <dev@catalogo-app.local>
Date: Thu, 3 Sep 2026 19:29:55 +0000
Subject: [PATCH] refactor: usar Gemini (gratis) en vez de Claude API para el
 agente de ventas

- Nuevo GeminiAgentService implementa IAgentService (misma interfaz de
  dominio, cero cambios en application/domain).
- Se elimina AnthropicAgentService y el SDK de Anthropic (no se usan).
- Requiere GEMINI_API_KEY en vez de ANTHROPIC_API_KEY (ver .env.example).
- Se obtiene gratis, sin tarjeta, en https://aistudio.google.com/apikey
---
 .env.example                                  |   6 +-
 package-lock.json                             | 546 ++++++++++++------
 package.json                                  |   2 +-
 src/infrastructure/http/routes/agentRoutes.ts |   4 +-
 ...cAgentService.ts => GeminiAgentService.ts} | 114 ++--
 5 files changed, 420 insertions(+), 252 deletions(-)
 rename src/infrastructure/services/{AnthropicAgentService.ts => GeminiAgentService.ts} (61%)

diff --git a/.env.example b/.env.example
index 781a516..81310c9 100644
--- a/.env.example
+++ b/.env.example
@@ -11,10 +11,10 @@ JWT_REFRESH_SECRET="cambia_esto_por_otro_secreto_largo_y_aleatorio"
 JWT_ACCESS_EXPIRES_IN="15m"
 JWT_REFRESH_EXPIRES_IN="7d"
 
-# --- Agente de ventas con IA (Claude) ---
-# Se obtiene en https://console.anthropic.com/ -> API Keys.
+# --- Agente de ventas con IA (Gemini, gratis) ---
+# Se obtiene en https://aistudio.google.com/apikey (sin tarjeta de crédito).
 # Sin esta variable, el endpoint /agente/chat responderá con error.
-ANTHROPIC_API_KEY="sk-ant-..."
+GEMINI_API_KEY="AIzaSy..."
 
 # --- Envío de emails (recuperación de contraseña, etc.) ---
 RESEND_API_KEY="re_..."
